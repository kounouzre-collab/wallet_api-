import uuid
from decimal import Decimal
from fastapi import FastAPI, Depends, HTTPException, status
from pydantic import BaseModel, Field
from sqlalchemy import Column, String, Numeric, select
from sqlalchemy.dialects.postgresql import UUID
from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker
from sqlalchemy.orm import DeclarativeBase

# 1. إعدادات قاعدة البيانات
DATABASE_URL = "postgresql+asyncpg://user:password@localhost/wallet_db"
engine = create_async_engine(DATABASE_URL, echo=True)
async_session_maker = async_sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)

class Base(DeclarativeBase):
    pass

async def get_db():
    async with async_session_maker() as session:
        yield session

# 2. جدول المحفظة
class UserWallet(Base):
    __tablename__ = "user_wallets"

    id = Column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    username = Column(String, unique=True, index=True, nullable=False)
    balance = Column(Numeric(precision=18, scale=2), default=0.00, nullable=False)

# 3. مخطط التحقق من البيانات
class TransferRequest(BaseModel):
    sender_id: UUID
    receiver_id: UUID
    amount: Decimal = Field(gt=0, description="المبلغ يجب أن يكون أكبر من صفر")

# 4. تطبيق FastAPI ومنطق التحويل الآمن
app = FastAPI(
    title="Secure High-Concurrency Wallet API",
    version="1.0.0",
    description="Enterprise-grade financial ledger API built with FastAPI and PostgreSQL."
)

@app.post("/transfer", status_code=status.HTTP_200_OK)
async def transfer_funds(data: TransferRequest, db: AsyncSession = Depends(get_db)):
    if data.sender_id == data.receiver_id:
        raise HTTPException(status_code=400, detail="لا يمكنك التحويل لنفس المحفظة!")

    async with db.begin():
        # قفل الصفوف لمنع Race Conditions
        sender_result = await db.execute(
            select(UserWallet).where(UserWallet.id == data.sender_id).with_for_update()
        )
        sender = sender_result.scalar_one_or_none()

        receiver_result = await db.execute(
            select(UserWallet).where(UserWallet.id == data.receiver_id).with_for_update()
        )
        receiver = receiver_result.scalar_one_or_none()

        if not sender or not receiver:
            raise HTTPException(status_code=404, detail="إحدى المحافظ غير موجودة.")

        if sender.balance < data.amount:
            raise HTTPException(status_code=400, detail="رصيد المرسل غير كافٍ.")

        # تنفيذ العملية المالية
        sender.balance -= data.amount
        receiver.balance += data.amount

    return {
        "status": "success",
        "message": "تمت عملية التحويل بنجاح وأمان تام.",
        "transferred_amount": str(data.amount)
    }