import uuid
import logging
from decimal import Decimal
from enum import Enum
from typing import Optional
from datetime import datetime

from fastapi import FastAPI, Depends, HTTPException, Header, status
from pydantic import BaseModel, Field, UUID4
from sqlalchemy import Column, String, Numeric, DateTime, ForeignKey, Enum as SQLEnum, select
from sqlalchemy.dialects.postgresql import UUID
from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker
from sqlalchemy.orm import DeclarativeBase, relationship

# ------------------------------------------------------------------------------
# 1. LOGGING & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
logger = logging.getLogger("financial_engine")

DATABASE_URL = "postgresql+asyncpg://user:password@localhost/wallet_db"
engine = create_async_engine(DATABASE_URL, echo=False, pool_size=20, max_overflow=10)
async_session_maker = async_sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)

class Base(DeclarativeBase):
    pass

async def get_db():
    async with async_session_maker() as session:
        yield session

# ------------------------------------------------------------------------------
# 2. DOMAIN ENUMS & MODELS (DOUBLE-ENTRY LEDGER ARCHITECTURE)
# ------------------------------------------------------------------------------
class EntryType(str, Enum):
    DEBIT = "DEBIT"    # إخراج أموال
    CREDIT = "CREDIT"  # إدخال أموال

class UserWallet(Base):
    __tablename__ = "user_wallets"

    id = Column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    owner_name = Column(String(100), nullable=False)
    currency = Column(String(3), default="USD", nullable=False)
    balance = Column(Numeric(precision=18, scale=4), default=Decimal("0.0000"), nullable=False)

class LedgerEntry(Base):
    """جدول دفتر القيد المزدوج - لا يمكن تعديله أو حذفه إطلاقاً"""
    __tablename__ = "ledger_entries"

    id = Column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    transaction_group_id = Column(UUID(as_uuid=True), nullable=False, index=True)
    wallet_id = Column(UUID(as_uuid=True), ForeignKey("user_wallets.id"), nullable=False)
    entry_type = Column(SQLEnum(EntryType), nullable=False)
    amount = Column(Numeric(precision=18, scale=4), nullable=False)
    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)

class IdempotencyRecord(Base):
    """سجل منع تكرار العمليات المالية عند مشاكل الشبكة"""
    __tablename__ = "idempotency_records"

    key = Column(String(255), primary_key=True)
    response_payload = Column(String, nullable=False)
    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)

# ------------------------------------------------------------------------------
# 3. PYDANTIC SCHEMAS (STRICT VALIDATION)
# ------------------------------------------------------------------------------
class TransferRequest(BaseModel):
    sender_id: UUID4
    receiver_id: UUID4
    amount: Decimal = Field(..., gt=Decimal("0.0000"), description="المبلغ يجب أن يكون أكبر من الصفر")
    description: Optional[str] = Field(None, max_length=255)

class TransferResponse(BaseModel):
    status: str
    transaction_id: str
    transferred_amount: str
    currency: str
    timestamp: datetime

# ------------------------------------------------------------------------------
# 4. HIGH-CONCURRENCY FINANCIAL API ENGINE
# ------------------------------------------------------------------------------
app = FastAPI(
    title="Enterprise Double-Entry Ledger API",
    version="2.0.0",
    description="High-throughput, ACID-compliant financial backend with row-level locking and idempotency protection."
)

@app.post(
    "/api/v1/transfer",
    response_model=TransferResponse,
    status_code=status.HTTP_200_OK
)
async def process_transfer(
    payload: TransferRequest,
    x_idempotency_key: str = Header(..., description="مفتاح فريد لمنع تكرار العملية"),
    db: AsyncSession = Depends(get_db)
):
    if payload.sender_id == payload.receiver_id:
        raise HTTPException(status_code=400, detail="INVALID_TRANSACTION: Sender and receiver cannot be identical.")

    # A. فحص مفتاح Idempotency لمنع المعاملات المزدوجة
    existing_key = await db.get(IdempotencyRecord, x_idempotency_key)
    if existing_key:
        logger.warning(f"Duplicate transaction attempt detected with key: {x_idempotency_key}")
        raise HTTPException(
            status_code=409, 
            detail="DUPLICATE_TRANSACTION: This operation has already been processed."
        )

    transaction_group_id = uuid.uuid4()

    # B. بدء المعاملة المالية الذرية (Atomic Async Transaction)
    async with db.begin():
        # ترتيب قفل الصفوف لمنع الـ Deadlocks في قاعدة البيانات
        first_id, second_id = sorted([payload.sender_id, payload.receiver_id])

        wallets_query = (
            select(UserWallet)
            .where(UserWallet.id.in_([first_id, second_id]))
            .with_for_update()  # قفل الصفوف الصارم لمنع Race Conditions
        )
        result = await db.execute(wallets_query)
        wallets = {w.id: w for w in result.scalars().all()}

        # التحقق من وجود المحفظتين
        if payload.sender_id not in wallets or payload.receiver_id not in wallets:
            raise HTTPException(status_code=404, detail="ACCOUNT_NOT_FOUND: One or both wallet IDs do not exist.")

        sender = wallets[payload.sender_id]
        receiver = wallets[payload.receiver_id]

        # التحقق من كفاية الرصيد
        if sender.balance < payload.amount:
            raise HTTPException(status_code=422, detail="INSUFFICIENT_FUNDS: Sender balance is too low.")

        # C. تنفيذ تغيير الرصيد
        sender.balance -= payload.amount
        receiver.balance += payload.amount

        # D. تسجيل القيد المزدوج في الـ Ledger (DEBIT & CREDIT)
        debit_entry = LedgerEntry(
            transaction_group_id=transaction_group_id,
            wallet_id=sender.id,
            entry_type=EntryType.DEBIT,
            amount=payload.amount
        )
        credit_entry = LedgerEntry(
            transaction_group_id=transaction_group_id,
            wallet_id=receiver.id,
            entry_type=EntryType.CREDIT,
            amount=payload.amount
        )
        
        # E. حفظ مفتاح Idempotency
        idempotency_record = IdempotencyRecord(
            key=x_idempotency_key,
            response_payload=f"SUCCESS:{transaction_group_id}"
        )

        db.add_all([debit_entry, credit_entry, idempotency_record])

    logger.info(f"Successfully processed transfer {transaction_group_id} of {payload.amount} {sender.currency}")

    return TransferResponse(
        status="SUCCESS",
        transaction_id=str(transaction_group_id),
        transferred_amount=str(payload.amount),
        currency=sender.currency,
        timestamp=datetime.utcnow()
    )

@app.get("/health", status_code=status.HTTP_200_OK)
async def health_check():
    return {"status": "healthy", "service": "ledger-engine", "timestamp": datetime.utcnow()}
